# Base de données
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/koere_db"

# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_secret_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_key_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Upload fichiers
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:4200
