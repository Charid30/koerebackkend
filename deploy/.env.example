# Copier en .env puis remplir. installer-serveur.sh le génère automatiquement avec des valeurs aléatoires.

# Adresse du site : ":80" pour un accès par l'IP (HTTP), ou un nom de domaine (HTTPS automatique)
SITE_ADDRESS=:80
# Origine(s) autorisée(s) par l'API, ex. http://185.0.0.1 ou https://gmao.exemple.com
CORS_ORIGINS=http://ADRESSE_IP_DU_SERVEUR

# Base de données (mots de passe longs et aléatoires : openssl rand -hex 24)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Clés de signature des jetons (openssl rand -hex 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
